<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yy.mapper.SysPermissionMapper">

    <resultMap id="BaseResultMap" type="com.yy.pojo.SysPermission">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="permCode" column="perm_code" jdbcType="VARCHAR"/>
            <result property="permName" column="perm_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="BIGINT"/>
            <result property="urlPattern" column="url_pattern" jdbcType="VARCHAR"/>
            <result property="httpMethod" column="http_method" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,perm_code,perm_name,
        create_time,update_time,del_flag,
        url_pattern,http_method
    </sql>
</mapper>
